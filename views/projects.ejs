<!-- Media Modal (in-page popup) -->
<div id="media-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4">
    <div class="relative w-full max-w-4xl">
        <button
            type="button"
            id="media-modal-close"
            class="absolute -top-2 -right-2 z-10 w-10 h-10 rounded-full bg-gray-900 border border-gray-800 text-white hover:border-neon hover:text-neon transition-colors duration-300"
            aria-label="Close"
        >
            <i class="fas fa-times"></i>
        </button>

        <div class="bg-gray-900 border border-gray-800 rounded-lg overflow-hidden">
            <div class="aspect-video bg-black">
                <video
                    id="media-modal-video"
                    class="w-full h-full object-contain bg-black"
                    controls
                    playsinline
                ></video>
            </div>
        </div>
    </div>
</div>

<script>
    // Filter functionality
    const filterBtns = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            // Update active button
            filterBtns.forEach(b => {
                b.classList.remove('bg-neon', 'text-dark');
                b.classList.add('border', 'border-gray-800', 'text-gray-400');
            });
            btn.classList.remove('border', 'border-gray-800', 'text-gray-400');
            btn.classList.add('bg-neon', 'text-dark');

            // Filter projects
            const filter = btn.dataset.filter;
            projectCards.forEach(card => {
                if (filter === 'all' || card.dataset.category === filter) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });

    // In-page media modal (used by RedOneLMS demo buttons)
    const mediaModal = document.getElementById('media-modal');
    const mediaModalVideo = document.getElementById('media-modal-video');
    const mediaModalClose = document.getElementById('media-modal-close');

    function openMediaModal(src) {
        if (!mediaModal || !mediaModalVideo) return;
        mediaModalVideo.src = src;
        // Slower playback for a calmer demo feel.
        mediaModalVideo.playbackRate = 0.65;
        mediaModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        mediaModalVideo.play().catch(() => {});
    }

    function closeMediaModal() {
        if (!mediaModal || !mediaModalVideo) return;
        mediaModal.classList.add('hidden');
        document.body.style.overflow = '';
        mediaModalVideo.pause();
        mediaModalVideo.removeAttribute('src');
        mediaModalVideo.load();
    }

    document.querySelectorAll('[data-video-src]').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            openMediaModal(btn.dataset.videoSrc);
        });
    });

    mediaModalClose?.addEventListener('click', closeMediaModal);
    mediaModal?.addEventListener('click', (e) => {
        // Close only when clicking the dark overlay
        if (e.target === mediaModal) closeMediaModal();
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mediaModal && !mediaModal.classList.contains('hidden')) {
            closeMediaModal();
        }
    });
</script>
