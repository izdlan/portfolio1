{
    "name": "my-portfolio",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css",
        "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
        "dev": "concurrently \"npm run watch:css\" \"nodemon server.js\"",
        "start": "npm run build:css && node server.js",
        "build": "npm run build:css"
    },
    "dependencies": {
        "dotenv": "^17.2.3",
        "ejs": "^3.1.9",
        "express": "^4.18.2",
        "express-ejs-layouts": "^2.5.1",
        "nodemailer": "^7.0.12",
        "path": "^0.12.7"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.1",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "nodemon": "^3.0.2",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
